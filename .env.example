# LLM (obrigatório)
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Busca web ao vivo (opcional).
# Sem estas chaves, o chatbot usa uma base de referência local e avisa que
# o dado pode estar desatualizado. A taxa Selic não depende delas: vem da API
# pública do Banco Central.
# Atenção: a Google Custom Search JSON API não aceita novos clientes e será
# desligada pelo Google em 01/01/2027.
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Servidor
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Origens liberadas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
